{
  "name": "board-game-be",
  "version": "1.0.0",
  "description": "Board game backend API with MVC architecture",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env src/index.js",
    "dev:watch": "nodemon --env-file=.env src/index.js",
    "start": "node --env-file=.env src/index.js",
    "migrate:make": "node --env-file=.env node_modules/.bin/knex migrate:make --knexfile knexfile.js",
    "migrate:latest": "node --env-file=.env node_modules/.bin/knex migrate:latest --knexfile knexfile.js",
    "migrate:rollback": "node --env-file=.env node_modules/.bin/knex migrate:rollback --knexfile knexfile.js",
    "migrate:status": "node --env-file=.env node_modules/.bin/knex migrate:status --knexfile knexfile.js",
    "seed:make": "node --env-file=.env node_modules/.bin/knex seed:make --knexfile knexfile.js",
    "seed:run": "node --env-file=.env node_modules/.bin/knex seed:run --knexfile knexfile.js",
    "seed:one": "node --env-file=.env src/db/seeds/run-seed.js"
  },
  "keywords": [
    "board-game",
    "express",
    "mvc",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
